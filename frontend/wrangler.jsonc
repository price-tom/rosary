{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "rosary-app",
	"compatibility_date": "2024-05-02",
	"observability": {
		"enabled": false
	},
	"assets": {
		"directory": "./build",
		"not_found_handling": "single-page-application"
	},
	"workers_dev": false,
	"preview_urls": false
}
